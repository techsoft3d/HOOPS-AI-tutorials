# ignore all zip, mp4 files anywhere
*.zip
*.mp4

# Ignore top-level 'packages' directory and its contents
/packages/*
/tutorials_data_1.0.*
/tutorials_data_1.0/*

# But keep the README.md file
!/packages/README.md


# Ignore 'out' directories anywhere in the repo
**/out/

# Ignore Jupyter notebook checkpoints adn python caches everywhere
**/.ipynb_checkpoints/
**/__pycache__/

# Ignore training_errors.log files anywhere
**/training_errors.log

#ignore private notebooks
/private_notebooks
demo_images.ipynb
/packagesb1

**/.hoops_embeddings_temp
**.faiss
**.meta
**/too_heavy_files.log
**/error_summary.json

# Agentic session state: the config (.hoops-ai/agent.toml) is tracked, the runtime state is not
.hoops-ai/*.db
.hoops-ai/*.db-*
.hoops-ai/sessions/
.hoops-ai/knowledge/
.hoops-ai/backups/

*.env
*.vscode
*.hoops-ai
